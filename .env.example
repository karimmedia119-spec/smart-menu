# ==========================================
# Smart Menu - Environment Configuration
# ==========================================

# 1. Cloud Database (Free Supabase or Neon PostgreSQL)
# Get a 100% free PostgreSQL instance in 60 seconds:
# - Supabase: https://supabase.com (Free 500MB DB)
# - Neon: https://neon.tech (Free Serverless Postgres)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# 2. Server Configuration
PORT=3000
NODE_ENV=development

# 3. Super Admin Credentials (Initial Setup)
SUPER_ADMIN_EMAIL=superadmin@smartmenu.app
SUPER_ADMIN_SECRET=smart_menu_master_key_2026

# 4. Instant Payment Wallets (Vodafone Cash & InstaPay)
INSTAPAY_IPA=smartmenu@instapay
VODAFONE_CASH_WALLET=01012345678
